# PlantMon Configuration

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

# Database
DATABASE_PATH=data/plantmon.db

# Sensor API Key (generate a random string, burn into ESP32 firmware)
SENSOR_API_KEY=change-me-to-random-string

# LLM (Ollama)
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT=120
LLM_MAX_TOKENS=500

# Monitoring
CHECK_INTERVAL_MINUTES=30
SENSOR_OFFLINE_THRESHOLD_MINUTES=30

# Default Plant Thresholds
DEFAULT_MOISTURE_MIN=30
DEFAULT_MOISTURE_MAX=70
